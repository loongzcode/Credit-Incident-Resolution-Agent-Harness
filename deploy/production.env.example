# Placeholder only: fill using your deployment Secret Manager, never commit populated values.
DATABASE_URL=postgresql+psycopg://RUNTIME_USER:SECRET@DATABASE_HOST/DATABASE
TENANT=deployment-tenant
OIDC_ISSUER=https://sso.example.invalid
OIDC_AUDIENCE=investigation-api
REGISTRY_ADMIN_AUDIENCE=registry-admin-api
OIDC_JWKS_URL=https://sso.example.invalid/jwks
OIDC_GROUP_ROLES={"credit-investigators":["INVESTIGATOR"],"credit-supervisors":["SUPERVISOR"]}
FRAME_CURSOR_HMAC_KEY=REPLACE_WITH_BASE64_RANDOM_32_BYTES
IDENTITY_ALIAS_HMAC_KEY=REPLACE_WITH_SEPARATE_BASE64_RANDOM_32_BYTES
CAPABILITY_SIGNING_SECRET=REPLACE_WITH_SECRET_MANAGER_VALUE
ALLOWED_ORIGINS=["https://console.example.invalid"]
EMBEDDING_MODEL=SET_APPROVED_MODEL
EMBEDDING_DIMENSION=1536
PLANNER_MODEL=SET_APPROVED_MODEL
OPENAI_API_KEY=INJECT_SECRET
TOOL_BINDINGS_FILE=/run/secrets/tool-bindings.json
RECONCILE_SECONDS=60
WORKER_LEASE_SECONDS=120
SHUTDOWN_GRACE_SECONDS=35
