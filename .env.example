# Copy into your shell environment; the application does not auto-load this file.
SIM_DATABASE_URL=postgresql+psycopg://sim:local-simulator-only@localhost:54329/credit_sim
# Optional isolated database for PostgreSQL integration tests:
# TEST_POSTGRES_URL=postgresql+psycopg://sim:local-simulator-only@localhost:54329/credit_sim_test

# Optional providers: set keys in your shell/secret manager, never commit them.
# OPENAI_API_KEY=...
# PLANNER_MODEL=<configured investigation model>
# REMEDIATION_MODEL=<configured remediation model>
# RUN_LLM_TESTS=1  # explicit opt-in for live tests; default tests are offline
# Step 15 optional remote embedding provider (not the Planner model).
# EMBEDDING_MODEL=<configured embedding model>
# EMBEDDING_DIMENSION=1536  # HNSW vector limit in this implementation: <=2000
# RUN_EMBEDDING_TESTS=1  # opt-in semantic quality test, never default CI

# Step 8: independent runtime authorization secret (at least 32 random bytes).
# Configure through shell / secret manager; never commit, log or send to a model.
# CAPABILITY_SIGNING_SECRET=<runtime secret>
# CAPABILITY_TTL_SECONDS=300  # allowed: 1..300 seconds
